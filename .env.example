# =====================================================================
# File MAU — sao chep thanh .env roi dien gia tri that:
#
#     copy .env.example .env
#
# Ung dung TU DOC file .env o goc du an nho dong spring.config.import trong
# application.yml — tinh nang san co cua Spring Boot, khong can thu vien nao.
# Nho vay khong phai khai bao bien moi truong trong IDE.
#
# .env nam trong .gitignore va KHONG BAO GIO duoc commit (NFR-07).
#
# Thu tu uu tien: bien moi truong > .env > application.yml
# CHI CLIENT_SECRET la bat buoc; moi gia tri khac deu da co mac dinh dung.
# =====================================================================

# Tenant duoc giang vien cap. Phai GIONG NHAU o ca hai he thong —
# neu UniSIS o TEAM07 ma UniLearn o TEAM08 thi du lieu khong bao gio khop.
TENANT_ID=TEAM07

# Dia chi hai he thong nguon.
# Chay cuc bo bang goi Integration_workshop cua giang vien: 8001 va 8002.
# Khi trien khai qua mot cong Nginx thuong co dang http://<SERVER>/sis va /lms
SIS_URL=http://127.0.0.1:8001
LMS_URL=http://127.0.0.1:8002

# Credentials trong phieu tai khoan. Neu hai he thong dung chung mot bo thi
# chi can dat CLIENT_ID va CLIENT_SECRET; muon tach rieng thi dung
# SIS_CLIENT_ID / SIS_CLIENT_SECRET / LMS_CLIENT_ID / LMS_CLIENT_SECRET.
CLIENT_ID=WEB-CONSOLE
# Goi chay cuc bo dung mac dinh "student-secret"; moi truong lab that thi lay
# theo phieu tai khoan.
CLIENT_SECRET=student-secret

# Che do hoat dong.
# Polling la XUONG SONG bao dam khong mat su kien — de bat.
# Webhook chi la lop tang toc do tre; neu may cham khong goi toi duoc dia chi
# callback thi dat ENABLE_WEBHOOK=false, he thong van dung, chi cham hon.
ENABLE_WEBHOOK=true
ENABLE_POLLING=true

# Dia chi cong khai ma hai he thong nguon goi nguoc ve. Chi can khi bat webhook.
WEBHOOK_PUBLIC_URL=http://<dia-chi-may-cua-ban>:8080

PORT=8080
